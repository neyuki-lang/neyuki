local table = require("@neyuki/table")
local math = require("@neyuki/math")
local task = require("@neyuki/task")

local audio = {}

-- Types other files can name as `audio.Sound` and `audio.Voice`. They are
-- erased at compile time and deliberately loose, as in `@neyuki/ui`.
export type Sound = { [string]: any }
export type Voice = { [string]: any }
export type LoadOptions = { stream: boolean? }
export type ToneOptions = { wave: string?, volume: number?, sampleRate: number? }
export type SampleOptions = { sampleRate: number?, channels: number? }
export type PlayOptions = {
    volume: number?,
    pan: number?,
    speed: number?,
    loop: boolean?,
    fadeIn: number?,
    start: number?,
    paused: boolean?,
}

-- Sound playback on top of the `__audio_*` natives in src/vm/libs/audio.rs
-- (`rodio` and `cpal`: WASAPI on Windows, Core Audio on macOS, ALSA on
-- Linux).
--
-- A *sound* is something that can be played: a file or bytes (WAV, Ogg
-- Vorbis, FLAC, MP3, AAC), a generated tone or a list of samples. Playing it
-- starts a *voice*, which is what is paused, stopped, panned, sped up or
-- moved around in. One sound can have any number of voices at once.
--
-- Sounds play on their own thread, so nothing has to be called every frame
-- and a script carries on while they play. The script ending ends them too:
-- `voice:wait()` is the way to let one finish.
--
-- The output device is opened the first time something needs it, so
-- loading and decoding work on a machine without one; `audio.isAvailable()`
-- says whether playing will.

function checkNumber(n: any, name: string)
    if (n == nil) then error(name .. " must be provided") end
    if (type(n) != "number") then error(name .. " must be a number") end
end

function checkString(s: any, name: string)
    if (s == nil) then error(name .. " must be provided") end
    if (type(s) != "string") then error(name .. " must be a string") end
end

function checkOptionalTable(t: any, name: string)
    if (t != nil and type(t) != "table") then error(name .. " must be a table") end
end

function optionalBoolean(b: any, name: string): boolean
    if (b == nil) then return false end
    if (type(b) != "boolean") then error(name .. " must be a boolean") end
    return b
end

function checkVolume(volume: any, name: string): number
    checkNumber(volume, name)
    if (volume < 0 or volume > 16 or volume != volume) then
        error(name .. " must be from 0 to 16")
    end
    return volume
end

function checkPan(pan: any): number
    checkNumber(pan, "pan")
    if (pan < -1 or pan > 1 or pan != pan) then error("pan must be from -1 to 1") end
    return pan
end

function checkSpeed(speed: any): number
    checkNumber(speed, "speed")
    if (not (speed > 0 and speed <= 16)) then error("speed must be above 0 and at most 16") end
    return speed
end

function checkSeconds(seconds: any, name: string): number
    checkNumber(seconds, name)
    if (not (seconds >= 0 and seconds < math.huge)) then
        error(name .. " must be a non-negative number of seconds")
    end
    return seconds
end

function checkSampleRate(rate: any): number
    checkNumber(rate, "sampleRate")
    if (rate < 1 or rate > 384000 or rate != math.floor(rate)) then
        error("sampleRate must be a whole number from 1 to 384000")
    end
    return rate
end

function checkSound(sound: any, name: string)
    if (type(sound) != "table" or sound.kind != "sound") then
        error(name .. " must be a sound from audio.load, audio.decode, audio.tone or audio.fromSamples")
    end
end

function makeVoice(id: number, sound: Sound, options: PlayOptions): Voice
    -- What the voice was last seen doing, kept for when it has finished and
    -- the native no longer knows it.
    local state = {
        done = false,
        paused = options.paused ?? false,
        position = options.start ?? 0,
        volume = options.volume ?? 1,
        pan = options.pan ?? 0,
        speed = options.speed ?? 1,
        loop = options.loop ?? false,
    }

    local function refresh()
        if (state.done) then return state end
        local done, paused, position, volume, pan, speed, looping = __audio_voice_get(id)
        if (done) then
            state.done = true
            state.paused = false
            if (position != nil) then state.position = position end
            return state
        end
        state.paused = paused
        state.position = position
        state.volume = volume
        state.pan = pan
        state.speed = speed
        state.loop = looping
        return state
    end

    local voice = { kind = "voice", sound = sound }

    -- Whether it is still sounding: false once it has ended or been
    -- stopped, and while it is paused.
    function voice.isPlaying(self: Voice): boolean
        local s = refresh()
        return not s.done and not s.paused
    end

    function voice.isPaused(self: Voice): boolean
        return refresh().paused
    end

    -- Whether it has ended, been stopped or lost its output device. A
    -- finished voice cannot be started again; play the sound again instead.
    function voice.isDone(self: Voice): boolean
        return refresh().done
    end

    function voice.pause(self: Voice): ()
        if (refresh().done) then return end
        state.paused = true
        __audio_voice_set(id, "paused", true)
    end

    function voice.resume(self: Voice): ()
        if (refresh().done) then return end
        state.paused = false
        __audio_voice_set(id, "paused", false)
    end

    -- Stops it, fading out over `fade` seconds (default 0, at once).
    function voice.stop(self: Voice, fade: number?): ()
        local seconds = checkSeconds(fade ?? 0, "fade")
        __audio_voice_stop(id, seconds)
    end

    -- Seconds into the sound. A looping voice counts from the start of
    -- the sound again each time round.
    function voice.position(self: Voice): number
        return refresh().position
    end

    -- Jumps to `seconds` into the sound. Instant for a loaded sound; a
    -- streamed one reopens its decoder there.
    function voice.seek(self: Voice, seconds: number): ()
        seconds = checkSeconds(seconds, "seconds")
        if (refresh().done) then return end
        __audio_voice_seek(id, seconds)
        state.position = seconds
    end

    function voice.volume(self: Voice): number
        return refresh().volume
    end

    -- 1 is the sound as recorded, 0 silent, above 1 louder (and clipping
    -- sooner). Changes glide over a few milliseconds, so they do not click.
    function voice.setVolume(self: Voice, volume: number): ()
        volume = checkVolume(volume, "volume")
        if (refresh().done) then return end
        state.volume = volume
        __audio_voice_set(id, "volume", volume)
    end

    function voice.pan(self: Voice): number
        return refresh().pan
    end

    -- -1 is fully left, 0 centred, 1 fully right.
    function voice.setPan(self: Voice, pan: number): ()
        pan = checkPan(pan)
        if (refresh().done) then return end
        state.pan = pan
        __audio_voice_set(id, "pan", pan)
    end

    function voice.speed(self: Voice): number
        return refresh().speed
    end

    -- Playback rate: 2 plays twice as fast and an octave higher, 0.5 half
    -- as fast and an octave lower.
    function voice.setSpeed(self: Voice, speed: number): ()
        speed = checkSpeed(speed)
        if (refresh().done) then return end
        state.speed = speed
        __audio_voice_set(id, "speed", speed)
    end

    function voice.isLooping(self: Voice): boolean
        return refresh().loop
    end

    -- Turning looping off lets the voice end at the end of the sound.
    function voice.setLoop(self: Voice, looping: boolean): ()
        if (type(looping) != "boolean") then error("loop must be a boolean") end
        if (refresh().done) then return end
        state.loop = looping
        __audio_voice_set(id, "loop", looping)
    end

    -- Waits until the voice is done. Inside a task only that task waits;
    -- elsewhere the script blocks. A looping voice is never done by
    -- itself, so waiting on one is an error.
    function voice.wait(self: Voice): ()
        if (refresh().loop and not state.done) then
            error("cannot wait for a looping voice; stop it or turn looping off first")
        end
        while (not refresh().done) do
            if (state.loop) then
                error("cannot wait for a looping voice; stop it or turn looping off first")
            end
            task.wait(0.01)
        end
    end

    return table.freeze(voice)
end

function makeSound(id: number, duration: number?, channels: number, sampleRate: number, streamed: boolean, path: string?): Sound
    local closed = false
    local sound = {
        kind = "sound",
        path = path,
        duration = duration,
        channels = channels,
        sampleRate = sampleRate,
        streamed = streamed,
    }

    function sound.id(self: Sound): number
        if (closed) then error("sound was closed") end
        return id
    end

    -- Starts a voice playing the sound; see `audio.play`.
    function sound.play(self: Sound, options: PlayOptions?): Voice
        return audio.play(self, options)
    end

    -- Frees the samples. Voices already playing it carry on to their end.
    function sound.close(self: Sound): ()
        if (closed) then return end
        closed = true
        __audio_release(id)
    end

    return table.freeze(sound)
end

function loadOptions(options: LoadOptions?): boolean
    checkOptionalTable(options, "options")
    return optionalBoolean((options ?? {}).stream, "stream")
end

-- Whether this build has audio and the machine has an output device that
-- opens. False on a build without the `audio` cargo feature, where every
-- other function raises an error, and on a machine with no sound device,
-- where only playing does.
function audio.isAvailable(): boolean
    return __audio_available()
end

-- Loads a sound file: WAV, FLAC, Ogg Vorbis, MP3 or AAC, from disk or from a
-- built app's files. It is decoded up front unless `stream = true`, which
-- keeps only the file's bytes and decodes while it plays: use that for
-- music, the decoded form of which is about ten times the size of an MP3.
function audio.load(path: string, options: LoadOptions?): Sound
    checkString(path, "path")
    local id, duration, channels, rate, streamed = __audio_load(path, loadOptions(options))
    return makeSound(id, duration, channels, rate, streamed, path)
end

-- Like `load`, from the bytes of a sound file in a buffer or string, such
-- as a download.
function audio.decode(data: any, options: LoadOptions?): Sound
    if (type(data) != "buffer" and type(data) != "string") then
        error("data must be a buffer or string")
    end
    local id, duration, channels, rate, streamed = __audio_decode(data, loadOptions(options))
    return makeSound(id, duration, channels, rate, streamed, nil)
end

local WAVES = { sine = true, square = true, saw = true, triangle = true, noise = true }

-- A generated mono tone `seconds` long. `wave` is "sine" (the default),
-- "square", "saw", "triangle" or "noise" (which ignores the frequency);
-- `volume` defaults to 0.5. It fades in and out over 2 ms so it starts and
-- ends without a click.
function audio.tone(frequency: number, seconds: number, options: ToneOptions?): Sound
    checkNumber(frequency, "frequency")
    if (not (frequency >= 0 and frequency < math.huge)) then
        error("frequency must be a non-negative number")
    end
    seconds = checkSeconds(seconds, "seconds")
    checkOptionalTable(options, "options")
    local o = options ?? {}
    local wave = o.wave ?? "sine"
    checkString(wave, "wave")
    if (not WAVES[wave]) then error("unknown wave `" .. wave .. "`") end
    local volume = checkVolume(o.volume ?? 0.5, "volume")
    local rate = checkSampleRate(o.sampleRate ?? 44100)
    local id, duration, channels, sampleRate = __audio_tone(wave, frequency, seconds, rate, volume)
    return makeSound(id, duration, channels, sampleRate, false, nil)
end

-- A sound from a list of samples from -1 to 1. With several `channels`
-- (default 1) the list is interleaved: left, right, left, right, ...
-- `sampleRate` defaults to 44100.
function audio.fromSamples(samples: {number}, options: SampleOptions?): Sound
    if (type(samples) != "table") then error("samples must be a list of numbers") end
    checkOptionalTable(options, "options")
    local o = options ?? {}
    local rate = checkSampleRate(o.sampleRate ?? 44100)
    local channels = o.channels ?? 1
    checkNumber(channels, "channels")
    if (channels < 1 or channels > 8 or channels != math.floor(channels)) then
        error("channels must be a whole number from 1 to 8")
    end
    local id, duration, count, sampleRate = __audio_samples(samples, rate, channels)
    return makeSound(id, duration, count, sampleRate, false, nil)
end

-- Starts a voice playing `sound` and returns it. Options:
--   volume  1 by default; 0 is silent, up to 16
--   pan     -1 (left) to 1 (right), 0 by default
--   speed   1 by default; 2 is twice as fast and an octave up
--   loop    play it again from the start each time it ends
--   fadeIn  seconds to fade in over
--   start   seconds into the sound to start from
--   paused  start paused, for `voice:resume()` later
-- Opens the output device on first use, and raises an error when there is
-- none.
function audio.play(sound: Sound, options: PlayOptions?): Voice
    checkSound(sound, "sound")
    checkOptionalTable(options, "options")
    local o = options ?? {}
    local resolved = {
        volume = checkVolume(o.volume ?? 1, "volume"),
        pan = checkPan(o.pan ?? 0),
        speed = checkSpeed(o.speed ?? 1),
        loop = optionalBoolean(o.loop, "loop"),
        fadeIn = checkSeconds(o.fadeIn ?? 0, "fadeIn"),
        start = checkSeconds(o.start ?? 0, "start"),
        paused = optionalBoolean(o.paused, "paused"),
    }
    local id = __audio_play(sound:id(), resolved.volume, resolved.pan, resolved.speed,
        resolved.loop, resolved.fadeIn, resolved.start, resolved.paused)
    return makeVoice(id, sound, resolved)
end

-- The master volume every voice is multiplied by, 1 at first.
function audio.volume(): number
    return __audio_volume()
end

function audio.setVolume(volume: number): ()
    __audio_volume(checkVolume(volume, "volume"))
end

-- Stops every voice, fading out over `fade` seconds (default 0).
function audio.stopAll(fade: number?): ()
    __audio_stop_all(checkSeconds(fade ?? 0, "fade"))
end

-- The open output device: `name`, `sampleRate` and `channels`. Opens it
-- if nothing has yet, and raises an error when there is none.
function audio.output(): { name: string, sampleRate: number, channels: number }
    local name, rate, channels = __audio_output()
    return table.freeze({ name = name, sampleRate = rate, channels = channels })
end

-- The names of the output devices, for `setDevice`. Empty when there are
-- none.
function audio.devices(): {string}
    return __audio_devices()
end

-- Switches output to the device called `name`, or back to the system
-- default with nil. Every playing voice stops, as it belonged to the old
-- device.
function audio.setDevice(name: string?): ()
    if (name != nil) then checkString(name, "name") end
    __audio_set_device(name)
end

return table.freeze(audio)
