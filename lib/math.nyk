local table = require("@neyuki/table")

local math = {}

const function math.random(min: number, max: number): number
    if (min == nil) or (max == nil) then
        error("Both min and max must be provided")
    end
    if (type(min) != "number") or (type(max) != "number") then
        error("Both min and max must be numbers")
    end
    if (min > max) then
        error("min must be less than or equal to max")
    end

    return __random_int(min, max)
end

const function getNumberTable(...: number|{}): {number}
    local t = {}
    local function handle(obj: number|{})
        if type(obj) == "number" then
            table.insert(t, obj)
        elseif type(obj) == "table" then
            for _, n in obj do
                handle(n)
            end
        else
            error("Invalid argument type: " .. type(obj))
        end
    end
    handle({...})
    return t
end

const function math.max(n1: number, n2: number, ...: number): number
    local t = getNumberTable(n1, n2, {...})
    local max = t[1]
    for _, n in t do
        if n > max then
            max = n
        end
    end
    return max
end

const function math.min(n1: number, n2: number, ...: number): number
    local t = getNumberTable(n1, n2, {...})
    local min = t[1]
    for _, n in t do
        if n < min then
            min = n
        end
    end
    return min
end

const function math.exp(n: number): number -- exponent e^n
    if (n == nil) then
        error("n must be provided")
    end
    if (type(n) != "number") then
        error("n must be a number")
    end

    return __exp(n)
end

const function math.abs(n: number): number
    if (n < 0) then
        return -n
    else
        return n
    end
end

const function math.clamp(n: number, min: number, max: number): number
    if (min > max) then
        error("min must be less than or equal to max")
    end
    if (n < min) then
        return min
    elseif (n > max) then
        return max
    else
        return n
    end
end

return math