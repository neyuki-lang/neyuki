local table = require("@neyuki/table")

local html = {}

-- Parsing, matching and writing are native (src/vm/libs/html.rs, on
-- html5ever); this module checks arguments.
--
-- Nodes are plain tables:
--   { type = "document", children = { ... } }      (or "fragment")
--   { type = "element", tag = "a", attrs = { href = "/" }, children = { ... } }
--   { type = "text", text = "..." }
--   { type = "comment", text = "..." }
--   { type = "doctype", name = "html" }
-- A string in `children` is a text node too.

local function checkString(s: any, name: string)
    if (s == nil) then error(name .. " must be provided") end
    if (type(s) != "string") then error(name .. " must be a string") end
end

local function checkNode(node: any)
    if (node == nil) then error("node must be provided") end
    if (type(node) != "table") then error("node must be a table") end
end

-- Parses an HTML document the way a browser does: missing tags such as
-- `<html>`, `<head>` and `<body>` are added and broken nesting is repaired.
function html.parse(text: string): {[string]: any}
    checkString(text, "text")
    return __html_parse(text, false)
end

-- Parses a piece of HTML as if it sat inside `<body>`, without adding a
-- document around it.
function html.parseFragment(text: string): {[string]: any}
    checkString(text, "text")
    return __html_parse(text, true)
end

-- The elements under `node` matching a CSS selector, in document order.
function html.select(node: {[string]: any}, selector: string): {any}
    checkNode(node)
    checkString(selector, "selector")
    return __html_select(node, selector, false)
end

-- The first element under `node` matching a CSS selector, or nil.
function html.selectOne(node: {[string]: any}, selector: string): {[string]: any}?
    checkNode(node)
    checkString(selector, "selector")
    return __html_select(node, selector, true)
end

-- The text of a node and everything under it, like the DOM's `textContent`.
function html.text(node: any): string
    if (node == nil) then error("node must be provided") end
    if (type(node) != "table" and type(node) != "string") then error("node must be a table") end
    return __html_text(node)
end

-- Writes a node and everything under it as HTML.
function html.render(node: any): string
    if (node == nil) then error("node must be provided") end
    if (type(node) != "table" and type(node) != "string") then error("node must be a table") end
    return __html_render(node)
end

-- Replaces `& < > " '` with character references, so `s` can go into HTML
-- text or a quoted attribute value.
function html.escape(s: string): string
    checkString(s, "s")
    return __html_escape(s)
end

return table.freeze(html)
