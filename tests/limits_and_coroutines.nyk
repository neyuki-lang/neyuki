-- Opaque so the compiler cannot fold what goes through it.
local function id(x: any): any
    return x
end

-- Integers past 2^20 bits are an error rather than an unbounded allocation,
-- whether the compiler or the VM computes them.
local function tooLarge(f: any): boolean
    local ok, err = try(f)
    return not ok and string.find(err, "too large") != nil
end
assert(tooLarge(function() return 1 << 100000000000 end), "a folded huge shift should be an error")
assert(tooLarge(function() return id(1) << id(100000000000) end), "a huge shift should be an error")
assert(tooLarge(function() return 2 ^ 100000000 end), "a folded huge power should be an error")
assert(tooLarge(function() return id(2) ^ id(100000000) end), "a huge power should be an error")
assert(tooLarge(function()
    local y = 3
    for i = 1, 30 do y = y * y end
    return y
end), "repeated squaring should stop at the limit")
assert(#tostring(id(2) ^ id(100000)) == 30103, "large results under the limit are exact")
assert(id(1) ^ id(5000000000) == 1, "1 to any power is 1")
assert(id(-1) ^ id(5000000001) == -1, "-1 to an odd power is -1")
assert(id(0) ^ id(5000000000) == 0, "0 to a positive power is 0")

-- Folding `bit` calls gives what calling them at runtime gives.
assert(bit.bnot(0) == bit.bnot(id(0)), "bit.bnot folds like the runtime")
assert(bit.lshift(1, 40) == bit.lshift(id(1), id(40)), "bit.lshift folds like the runtime")
assert(bit.band(-1, 0xFFFFFFFFFF) == bit.band(id(-1), id(0xFFFFFFFFFF)), "bit.band folds like the runtime")
assert(bit.rshift(-8, 1) == bit.rshift(id(-8), id(1)), "bit.rshift folds like the runtime")

-- Coroutines pass values both ways and finish dead.
local co = coroutine.create(function(a: number): number
    local b = coroutine.yield(a + 1)
    return b * 2
end)
local ok, value = coroutine.resume(co, 1)
assert(ok and value == 2, "first resume should yield a + 1")
ok, value = coroutine.resume(co, 10)
assert(ok and value == 20, "second resume should return b * 2")
assert(coroutine.status(co) == "dead", "a finished coroutine is dead")
ok, value = coroutine.resume(co)
assert(not ok and value == "cannot resume dead coroutine", "a dead coroutine cannot be resumed")

-- The handle cannot be edited or imitated to revive or drive a coroutine.
assert(not try(function() co.status = "suspended" end), "the handle should be frozen")
assert(coroutine.status(co) == "dead", "the coroutine should still be dead")
ok, value = coroutine.resume({ _id = 1, __type = "thread" })
assert(not ok, "a table that only looks like a handle should not resume anything")

-- coroutine.running gives back the handle create returned.
local inner
local outer = coroutine.create(function()
    inner = coroutine.running()
    coroutine.yield()
end)
coroutine.resume(outer)
assert(inner == outer, "running should return the coroutine's own handle")
assert(coroutine.status(inner) == "suspended", "the handle should report the live status")

-- Yielding through a native function is an error, not a corrupted resume.
local function yieldsAcrossNative(body: any): boolean
    local c = coroutine.create(body)
    local resumed, err = coroutine.resume(c)
    if resumed then
        -- `try` turns the yield error into a result inside the coroutine.
        return err == "caught"
    end
    return string.find(err, "yield across a native function call") != nil
end
assert(yieldsAcrossNative(function()
    local caught, err = try(function() coroutine.yield(1) end)
    assert(not caught and string.find(err, "yield across") != nil, "try should catch the error")
    return "caught"
end), "yield inside try")
assert(yieldsAcrossNative(function()
    table.sort({3, 1, 2}, function(a, b)
        coroutine.yield()
        return a < b
    end)
end), "yield inside a sort comparator")
assert(yieldsAcrossNative(function()
    local t = setmetatable({}, { __index = function(t, k) return coroutine.yield(k) end })
    return t.foo
end), "yield inside a metamethod")

-- Generators through coroutine.wrap still yield normally.
local gen = coroutine.wrap(function()
    for i = 1, 3 do coroutine.yield(i) end
end)
assert(gen() == 1 and gen() == 2 and gen() == 3, "wrap should yield each value")

print("[pass] limits and coroutines")
