-- @neyuki/audio. Nothing here needs a sound device: decoding works without
-- one, and the playback checks run on the null output, which mixes only when
-- `__audio_render` pulls frames from it. That makes them exact: the null
-- output runs at the fixtures' own 8 kHz, so a voice at speed 1 hands its
-- samples through unchanged.
local audio = require("@neyuki/audio")

local function fails(f, ...)
    local ok, err = try(f, ...)
    assert(not ok, "expected an error")
    return err
end

local function near(a, b, what)
    assert(math.abs(a - b) < 1e-4, `{what}: expected {b}, got {a}`)
end

-- A build without the `audio` cargo feature only has `isAvailable`.
local built, why = try(audio.tone, 440, 0.01)
if (not built and string.find(why, "without the `audio` feature", 1, true)) then
    assert(not audio.isAvailable(), "a build without audio says so")
    print("audio: skipping (built without the `audio` feature)")
    return
end

-- ARGUMENTS ------------------------------------------------------------------

assert(type(audio.isAvailable) == "function", "isAvailable exists")
assert(fails(audio.load, nil) == "path must be provided", "load needs a path")
assert(fails(audio.load, "tests/fixtures/ramp.wav", { stream = 1 }) == "stream must be a boolean", "stream is a boolean")
assert(string.find(fails(audio.load, "tests/fixtures/missing.wav"), "cannot open", 1, true), "a missing file is reported")
assert(string.find(fails(audio.load, "tests/fixtures/dot.png"), "unrecognized audio format", 1, true), "an image is not a sound")
assert(fails(audio.decode, 5) == "data must be a buffer or string", "decode needs bytes")
assert(string.find(fails(audio.decode, "not a sound file"), "unrecognized audio format", 1, true), "decode checks the format")
assert(fails(audio.tone, 440, -1) == "seconds must be a non-negative number of seconds", "tone checks seconds")
assert(fails(audio.tone, 440, 1, { wave = "organ" }) == "unknown wave `organ`", "tone checks the wave")
assert(fails(audio.tone, 440, 1, { sampleRate = 0 }) == "sampleRate must be a whole number from 1 to 384000", "tone checks the rate")
assert(fails(audio.fromSamples, { 0.1, 0.2, 0.3 }, { channels = 2 }) == "the number of samples must be a multiple of channels (2)", "samples fill whole frames")
assert(fails(audio.fromSamples, { 0.1, "x" }) == "samples[2] must be a number", "samples are numbers")
assert(fails(audio.fromSamples, {}, { channels = 9 }) == "channels must be a whole number from 1 to 8", "channels are limited")
assert(string.find(fails(audio.play, {}), "sound must be a sound", 1, true), "play needs a sound")

-- SOUNDS ---------------------------------------------------------------------

local ramp = audio.load("tests/fixtures/ramp.wav")
assert(ramp.channels == 1 and ramp.sampleRate == 8000, "ramp.wav is mono at 8 kHz")
near(ramp.duration, 0.25, "ramp duration")
assert(not ramp.streamed and ramp.path == "tests/fixtures/ramp.wav", "a loaded sound")

local streamed = audio.load("tests/fixtures/ramp.wav", { stream = true })
assert(streamed.streamed, "stream = true streams")
near(streamed.duration, 0.25, "a streamed WAV knows its duration")

local stereo = audio.load("tests/fixtures/stereo.wav")
assert(stereo.channels == 2, "stereo.wav has two channels")
near(stereo.duration, 0.1, "stereo duration")

local beep = audio.tone(1000, 0.5, { sampleRate = 8000 })
assert(beep.channels == 1 and beep.sampleRate == 8000, "a tone is mono")
near(beep.duration, 0.5, "tone duration")

local pcm = audio.fromSamples({ 0.1, 0.2, 0.3, 0.4 }, { sampleRate = 8000 })
near(pcm.duration, 4 / 8000, "fromSamples duration")

local closing = audio.fromSamples({ 0 })
closing:close()
closing:close()
assert(fails(audio.play, closing) == "sound was closed", "a closed sound cannot be played")
assert(table.isfrozen(audio) and table.isfrozen(ramp), "the library and its sounds are frozen")

-- PLAYBACK ON THE NULL OUTPUT ------------------------------------------------

__audio_open_null(8000, 2)
local out = audio.output()
assert(out.name == "null" and out.sampleRate == 8000 and out.channels == 2, "the null output")
assert(audio.isAvailable(), "an open output is available")

-- Renders `frames` frames and returns the left and right channels.
local function render(frames)
    local samples = __audio_render(frames)
    local left, right = {}, {}
    for i = 1, frames do
        left[i] = samples[2 * i - 1]
        right[i] = samples[2 * i]
    end
    return left, right
end

local function rampAt(frame)
    -- What ramp.wav holds at a 0-based frame.
    return math.floor(frame / 2000 * 16384) / 32768
end

-- A stereo sound reaches both channels unchanged.
local v = stereo:play()
local l, r = render(4)
near(l[1], 0.5, "stereo left")
near(r[1], -0.25, "stereo right")
v:stop()
render(1)
assert(v:isDone() and not v:isPlaying(), "a stopped voice is done")

-- A mono sound is spread over both, and pan and volume weigh them.
v = ramp:play({ pan = -1, volume = 0.5 })
l, r = render(3)
near(l[3], rampAt(2) * 0.5, "panned left at half volume")
near(r[3], 0, "nothing on the right")
v:stop()

-- It ends on its own, and the mix is silent after.
v = ramp:play()
l, r = render(2000)
near(l[1001], rampAt(1000), "the ramp plays through")
near(r[1001], rampAt(1000), "on both channels")
assert(not v:isDone(), "not done until the last frame has been mixed")
l = render(4)
assert(v:isDone(), "done at the end")
near(v:position(), 0.25, "a finished voice reports the end")
near(l[2], 0, "silence after")

-- Looping.
v = pcm:play({ loop = true })
l = render(10)
near(l[1], 0.1, "loop 1")
near(l[4], 0.4, "loop 4")
near(l[5], 0.1, "loop wraps")
near(l[10], 0.2, "loop again")
assert(v:isPlaying() and v:isLooping(), "still playing")
assert(string.find(fails(v.wait, v), "cannot wait for a looping voice", 1, true), "waiting on a loop is refused")
v:setLoop(false)
render(8)
assert(v:isDone(), "turning looping off lets it end")

-- Speed, and a start offset.
v = ramp:play({ speed = 2, start = 0.125 })
near(v:position(), 0.125, "starts where asked")
l = render(3)
near(l[1], rampAt(1000), "starts at frame 1000")
near(l[3], rampAt(1004), "two frames per frame at speed 2")
v:stop()

-- Pausing holds the position and outputs silence; resuming glides back in.
v = ramp:play({ paused = true })
assert(v:isPaused() and not v:isPlaying(), "starts paused")
l = render(100)
near(l[100], 0, "silent while paused")
near(v:position(), 0, "the position holds")
v:resume()
l = render(600)
near(l[600], rampAt(599), "back at full volume once resumed")
v:pause()
render(400)
local held = v:position()
render(400)
near(v:position(), held, "paused again, it holds")
v:stop()

-- Seeking: instant for a loaded sound, decoded up to for a streamed one.
v = ramp:play()
render(10)
v:seek(0.2)
near(v:position(), 0.2, "seek reports at once")
l = render(2)
near(l[1], rampAt(1600), "a loaded sound seeks")
v:stop()

v = streamed:play()
l = render(500)
near(l[500], rampAt(499), "a streamed sound plays the same samples")
v:seek(0.05)
l = render(2)
near(l[1], rampAt(400), "a streamed sound seeks back")
v:seek(0.2)
l = render(2)
near(l[1], rampAt(1600), "and forward")
render(400)
render(4)
assert(v:isDone(), "a streamed sound ends")

v = streamed:play({ loop = true, start = 0.2 })
l = render(500)
near(l[1], rampAt(1600), "a looping stream starts mid-way")
near(l[401], rampAt(0), "and goes round")
v:stop()

-- Fading out takes the time asked for, then the voice is done.
local steady = audio.fromSamples({ 0.4, 0.4, 0.4, 0.4 }, { sampleRate = 8000 })
v = steady:play({ loop = true })
v:stop(0.01)
l = render(80)
near(l[40], 0.2, "halfway through the 80-frame fade")
assert(not v:isDone(), "still fading")
render(2)
assert(v:isDone(), "done after the fade")

-- Fading in starts from silence.
v = pcm:play({ loop = true, fadeIn = 0.1 })
l = render(4)
assert(math.abs(l[1]) < 0.01, "a fade-in starts quiet")
v:stop()

-- The master volume scales every voice.
audio.setVolume(0.5)
near(audio.volume(), 0.5, "master volume")
v = stereo:play()
l = render(400)
near(l[400], 0.25, "master volume halves the mix")
audio.setVolume(1)
audio.stopAll()
render(2)
assert(v:isDone(), "stopAll stops every voice")

-- Several voices add up.
pcm:play({ loop = true })
pcm:play({ loop = true, volume = 0.5 })
l = render(4)
near(l[2], 0.2 * 1.5, "voices mix")
audio.stopAll()
render(2)

-- A voice keeps going after its sound is closed.
local temporary = audio.fromSamples({ 0.3, 0.3, 0.3, 0.3 }, { sampleRate = 8000 })
v = temporary:play()
temporary:close()
l = render(2)
near(l[1], 0.3, "playing on after close")
render(4)

-- Switching output ends the old voices.
v = pcm:play({ loop = true })
__audio_open_null(8000, 1)
assert(v:isDone(), "voices end with their output")
v = stereo:play()
l = __audio_render(2)
near(l[1], 0.125, "a mono output gets the average of left and right")

-- Rejected while playing.
assert(fails(v.setPan, v, 2) == "pan must be from -1 to 1", "setPan checks")
assert(fails(v.setSpeed, v, 0) == "speed must be above 0 and at most 16", "setSpeed checks")
assert(fails(v.setVolume, v, -1) == "volume must be from 0 to 16", "setVolume checks")
assert(fails(v.seek, v, -1) == "seconds must be a non-negative number of seconds", "seek checks")
assert(fails(audio.play, pcm, { loop = "yes" }) == "loop must be a boolean", "play checks loop")
v:stop()
render(1)

print("[pass] audio")
