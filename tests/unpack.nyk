local table = require("@neyuki/table")
local numbers = {10, 20, 30}

local values = {table.unpack(numbers)}
assert(values[1] == 10)
assert(values[2] == 20)
assert(values[3] == 30)
assert(#values == 3)

-- `...` at the end of a call spreads even when several results are kept
local function count(...) return select("#", ...), ... end
local function forward(...)
    local n, first = count(0, ...)
    return n, first
end
local n, first = forward(1, 2, 3)
assert(n == 4 and first == 0, "trailing varargs are passed in full")

print("unpack ok")
