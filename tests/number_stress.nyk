local math = require("@neyuki/math")

-- test 1: auto-widening i64 to bigint
local small: int = 2^62
local big = small * 8
assert(typeof(big) == "bigint", "expected bigint widening")
assert(type(big) == "number", "base type must stay number")

-- test 2: division rules
local floatDiv: float = 7 / 2
local intDiv: int = 7 // 2
assert(floatDiv == 3.5, "slash must produce float")
assert(intDiv == 3, "double slash must floor int")

-- test 3: bitwise shifts widening
local shifted = 1 << 65
assert(typeof(shifted) == "bigint", "large shift should widen")

local hex = 0x1_0000_0000_0000_0000
local binary = 0b1_0000_0000
assert(hex == 18446744073709551616, "hex bigint literal should stay exact")
assert(binary == 256, "binary bigint literal should parse")
assert(math.exp(0) == 1, "exp(0) should equal 1")
assert(math.exp(1) > 2.71828, "exp(1) should be greater than 2.71828")
assert(math.exp(1) < 2.71829, "exp(1) should be less than 2.71829")
assert(math.floor(3.9) == 3, "floor should round positive floats down")
assert(math.floor(-3.1) == -4, "floor should round negative floats down")
assert(math.floor(4) == 4, "floor should preserve integers")

print(`[pass] numbers & widening: 2^62 * 8 = {big} ({typeof(big)})`)