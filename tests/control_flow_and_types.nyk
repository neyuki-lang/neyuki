local string = require("@neyuki/string")

const users: {string} = {"janis", "syv", "root"}
const scores: {[string]: int} = { janis = 100, syv = 95 }

-- generic loop directly over array (no ipairs)
for i, name in users do
    print(`user {i}: {name}`)
end

-- generic loop directly over map (no pairs)
for k, v in scores do
    print(`score {k} = {v}`)
end

-- nil-coalescing check
local fallback: string? = nil
local activeUser: string = fallback ?? "guest"

-- strict boolean condition (activeUser != "" required, truthiness fails)
if activeUser != "guest" then
    print(`logged in: {activeUser}`)
else
    print("running as fallback guest")
end

-- an optional parameter given a default is no longer optional
local function withDefault(count: number?): number
    count = count ?? 1
    return count
end
assert(withDefault() == 1 and withDefault(4) == 4, "defaults narrow optionals")

-- values left out of a multi-value return are nil
local function lookup(found: boolean): (number?, string?)
    if (not found) then return nil end
    return 1, "one"
end
assert(lookup(false) == nil and select(2, lookup(true)) == "one", "partial returns")
