local gpu = require("@neyuki/gpu")
local fs = require("@neyuki/fs")
local string = require("@neyuki/string")

function expectError(f: any, needle: string, message: string, ...: any)
    local ok, err = try(f, ...)
    assert(not ok and string.find(tostring(err), needle, 1, true) != nil, message .. ": " .. tostring(err))
end

-- ARGUMENTS (no display or adapter needed) ---------------------------------

assert(type(gpu.isAvailable()) == "boolean", "isAvailable reports a boolean")
expectError(gpu.clear, "window must be a window from ui.open", "clear checks its window", nil, "#fff")
expectError(gpu.clear, "window must be a window from ui.open", "clear rejects a plain table", {}, "#fff")

-- Without the `gpu` cargo feature everything but `isAvailable` says so, and
-- `ui.open` refuses `gpu = true`. With it, a window is needed first, so
-- `gpu.adapter()` fails either way until the live checks below.
expectError(gpu.adapter, "GPU", "adapter needs a GPU window or the feature")

-- LIVE WINDOW (opt in with an empty tests/gpu.local file) ------------------
--
-- Needs a build with the `gpu` cargo feature, a display and an adapter --
-- and, on macOS, the main thread, which `cargo test` does not provide. The
-- marker keeps CI headless, like tests/ui.local does for @neyuki/ui.
local ui = require("@neyuki/ui")
if (not fs.exists("tests/gpu.local")) then
    print("gpu: skipping the live checks (no tests/gpu.local)")
    return
end

assert(ui.isAvailable(), "tests/gpu.local is present but no display is available")
if (not gpu.isAvailable()) then
    expectError(ui.open, "no GPU support", "ui.open refuses gpu = true without the feature",
        { visible = false, gpu = true })
    print("gpu: skipping the live checks (this build has no GPU support)")
    return
end

local win = ui.open({ title = "Neyuki gpu test", width = 160, height = 120, visible = false, gpu = true })

local info = gpu.adapter()
assert(type(info.name) == "string" and #info.name > 0, "the adapter has a name")
assert(info.backend == "vulkan" or info.backend == "dx12" or info.backend == "metal"
    or info.backend == "gl", "the backend is one of the known ones, got " .. tostring(info.backend))

-- A GPU window has no CPU back buffer, so every `ui` drawing call and
-- `present` must refuse it with an error rather than crash.
expectError(win.line, "gpu = true", "line refuses a GPU window", win, 0, 0, 10, 10, "#fff")
expectError(win.clear, "gpu = true", "clear refuses a GPU window", win, "#fff")
expectError(win.fillRect, "gpu = true", "fillRect refuses a GPU window", win, 0, 0, 5, 5, "#fff")
expectError(win.text, "gpu = true", "text refuses a GPU window", win, 0, 0, "hi")
expectError(win.getPixel, "gpu = true", "getPixel refuses a GPU window", win, 0, 0)
expectError(win.present, "gpu = true", "present refuses a GPU window", win)

gpu.clear(win, "#9ac2e8")
gpu.clear(win, { r = 10, g = 20, b = 30 })
gpu.clear(win, 0x9ac2e8ff)
expectError(gpu.clear, "color must be", "clear checks its colour", win, "nope")

-- A CPU window is the other way round: `ui` draws it and `@neyuki/gpu` will
-- not touch it.
local cpu = ui.open({ width = 80, height = 60, visible = false })
cpu:clear("#000")
cpu:present()
expectError(gpu.clear, "not opened with gpu = true", "gpu.clear refuses a CPU window", cpu, "#fff")
cpu:close()

win:close()
expectError(gpu.clear, "window is closed", "a closed GPU window is unusable", win, "#fff")
print("gpu: live checks passed")
