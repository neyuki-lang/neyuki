-- html: browser-grade parsing, CSS selectors, text, rendering and escaping.

local html = require("@neyuki/html")

local page = html.parse([[
<!DOCTYPE html>
<title>Shop &amp; more</title>
<ul id="items">
  <li class="item sale" data-price="5"><a href="/a">Apple</a>
  <li class="item"><a href="/b">Banana</a>
  <li class="item sale" data-price="12"><a href="https://x.test/c">Cherry</a>
</ul>
<p>Unclosed <b>bold <i>both</b> italic</i>
<!-- note -->
<template><span>inside</span></template>
]])

assert(page.type == "document", "documents")
assert(page.children[1].type == "doctype" and page.children[1].name == "html", "doctype")
assert(html.selectOne(page, "html > head > title") != nil, "missing html and head tags are added")
assert(html.selectOne(page, "html > body > ul") != nil, "missing body tags are added")

local title = html.selectOne(page, "title")
assert(html.text(title) == "Shop & more", "entities are decoded")

local items = html.select(page, "ul#items > li.item")
assert(#items == 3, "implied end tags close each li: " .. #items)
assert(items[1].tag == "li" and items[1].attrs["data-price"] == "5", "attributes")
assert(string.trim(html.text(items[2])) == "Banana", "text of an element")

local function texts(nodes: {any}): string
    local out = {}
    for _, node in nodes do
        out[#out + 1] = html.text(node)
    end
    return table.concat(out, ",")
end

assert(texts(html.select(page, ".sale a")) == "Apple,Cherry", "descendant combinator")
assert(texts(html.select(page, "li:last-child a, li:nth-child(2) a")) == "Banana,Cherry", "selector lists in document order")
assert(texts(html.select(page, "a[href^='https']")) == "Cherry", "attribute prefix")
assert(texts(html.select(page, "li:not(.sale) > a")) == "Banana", ":not")
assert(texts(html.select(page, "li + li > a")) == "Banana,Cherry", "adjacent sibling")
assert(texts(html.select(page, "[data-price] a")) == "Apple,Cherry", "attribute presence")
assert(#html.select(items[1], "li") == 0, "select searches below the node, not the node itself")
assert(html.selectOne(page, "video") == nil, "no match is nil")

local b = html.selectOne(page, "p > b")
assert(b != nil and html.selectOne(b, "i") != nil, "misnested formatting is repaired like a browser")
assert(html.text(html.selectOne(page, "template")) == "inside", "template contents are children")

local ok, err = try(html.select, page, "li:hover")
assert(not ok and string.find(err, "unsupported pseudo-class", 1, true) != nil, "unknown pseudo-classes are errors")
assert(not try(html.select, page, "ul >"), "incomplete selectors are errors")

-- fragments and rendering
local fragment = html.parseFragment('<p class="x">Hi <b>there</b></p> & bye')
assert(fragment.type == "fragment" and #fragment.children == 2, "fragments have no document around them")
assert(html.render(fragment) == '<p class="x">Hi <b>there</b></p> &amp; bye', "render: " .. html.render(fragment))

local built = {
    tag = "div",
    attrs = { id = "card", hidden = true, skipped = false, title = 'a "quote"' },
    children = {
        { tag = "img", attrs = { src = "x.png" } },
        "1 < 2",
        { tag = "script", children = { "if (a < b) {}" } },
        { type = "comment", text = " c " },
    },
}
local rendered = html.render(built)
assert(rendered == '<div hidden id="card" title="a &quot;quote&quot;"><img src="x.png">1 &lt; 2<script>if (a < b) {}</script><!-- c --></div>', "render built tables: " .. rendered)
assert(#html.select(built, "img[src$='.png']") == 1, "select works on built tables")
assert(html.text(built) == "1 < 2if (a < b) {}", "text of built tables")
assert(not try(html.render, { tag = "a b" }), "invalid tag names are rejected")

assert(html.escape([[<a href="x">'&'</a>]]) == "&lt;a href=&quot;x&quot;&gt;&#39;&amp;&#39;&lt;/a&gt;", "escape")

local reparsed = html.parse(html.render(page))
assert(#html.select(reparsed, "li.item") == 3, "render and parse round trip")
