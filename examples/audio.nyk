-- A short tune from generated tones: a melody, a bass line under it, and a
-- chord that sweeps from left to right and fades out.
--
--     neyuki examples/audio.nyk
--     neyuki examples/audio.nyk path/to/song.ogg   -- plays a file instead
local audio = require("@neyuki/audio")

if (not audio.isAvailable()) then
    print("no audio output device")
    return
end

local out = audio.output()
print(`playing on {out.name} ({out.sampleRate} Hz, {out.channels} channels)`)

local path = os.args()[1]
if (path != nil) then
    local song = audio.load(path, { stream = true })
    print(`{path}: {song.channels} channels at {song.sampleRate} Hz`)
    local voice = song:play({ fadeIn = 1 })
    voice:wait()
    return
end

-- The frequency of a note `semitones` above A4.
local function note(semitones: number): number
    return 440 * 2 ^ (semitones / 12)
end

-- One sound per pitch, made once and played as often as needed.
local cache = {}
local function tone(semitones: number, seconds: number, wave: string): any
    local key = `{semitones}/{seconds}/{wave}`
    cache[key] = cache[key] ?? audio.tone(note(semitones), seconds, { wave = wave, volume = 0.25 })
    return cache[key]
end

local melody = { 3, 7, 10, 15, 14, 10, 7, 10, 12, 8, 5, 8, 7, 3, 7, -2 }
local bass = { -21, -21, -16, -16, -23, -23, -18, -18 }

for i, semitones in melody do
    tone(semitones, 0.22, "triangle"):play({ pan = 0.2 })
    if (i % 2 == 1) then
        tone(bass[(i + 1) // 2], 0.42, "sine"):play({ volume = 1.4, pan = -0.2 })
    end
    task.wait(0.22)
end

-- The last chord drifts across while it fades.
local chord = {}
for _, semitones in { 3, 7, 10, 15 } do
    chord[#chord + 1] = tone(semitones, 3, "saw"):play({ volume = 0.3, pan = -1, fadeIn = 0.05 })
end
for step = 0, 20 do
    for _, voice in chord do voice:setPan(-1 + step / 10) end
    task.wait(0.05)
end
for _, voice in chord do voice:stop(1.5) end
chord[1]:wait()
